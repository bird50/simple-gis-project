DATABASE_URL="postgresql://postgres:postgres@localhost:5432/water_gis?schema=public"
AUTH_SECRET="replace-with-at-least-32-random-characters"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-development-password"
# Separate SQLite photo service (server-side only)
TOOLBOX_SERVICE_URL="http://127.0.0.1:4010"
# Key with scopes read,write: publishing (Share Public of photos and drawings). Also signs guest publisher cookies.
TOOLBOX_SERVICE_KEY="replace-with-at-least-32-random-characters"
# Optional key with scope read: public photo/drawing layers, images and share pages. Empty = use the key above.
TOOLBOX_SERVICE_READ_KEY=""
