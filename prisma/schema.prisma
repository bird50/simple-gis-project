generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LayerType {
  GEOJSON
  VECTOR_TILE
  RASTER_TILE
  WMS
  WFS
  ARCGIS_REST
  REST_API
}

enum AccessLevel {
  PUBLIC
  MEMBER
  ADMIN
}
model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  passwordHash String
  firstName String
  lastName String
  role Role @default(MEMBER)
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?
  auditLogs AuditLog[]
  photoShares PhotoShare[]
}
model GisLayer {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String?
  groupName String
  type LayerType
  url String
  visible Boolean @default(false)
  enabled Boolean @default(true)
  opacity Float @default(1)
  minZoom Float @default(0)
  maxZoom Float @default(24)
  sortOrder Int @default(0)
  accessLevel AccessLevel @default(MEMBER)
  config Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action String
  resource String
  resourceId String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([userId])
}

model PhotoShare {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  eventName String
  tags String[]
  published Boolean @default(true)
  createdAt DateTime @default(now())
  photos SharedPhoto[]
  @@index([ownerId, createdAt])
}

model SharedPhoto {
  id String @id @default(cuid())
  shareId String
  share PhotoShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  name String
  image Bytes
  mimeType String @default("image/jpeg")
  longitude Float
  latitude Float
  capturedAt String
  capturedOffset String?
  sortOrder Int
  @@index([shareId, sortOrder])
  @@index([latitude, longitude])
}
